{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "dom",
      "es2020"
    ],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "guide-runtime": [
        "runtime/index.tsx"
      ],
      "script-to-guide": [
        "src/index.ts"
      ]
    }
  },
  "include": [
    "runtime",
    "src",
    "player",
    "guides",
    "gallery"
  ]
}
