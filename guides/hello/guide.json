{
  "build": {
    "out": "dist",
    "copy": [{ "from": "guides/hello/public/screens", "to": "screens", "ext": [".webp"] }],
    "audio": { "from": "guides/hello/recordings/narration.mp3", "to": "narration.mp3", "bitrate": "96k" },
    "captions": "guides/hello/data/captions.json",
    "chars": ["guides/hello"]
  },
  "page": {
    "lang": "en",
    "title": "Hello, script-to-guide",
    "font": { "family": "Guide Sans" }
  },
  "tts": {
    "provider": "edge",
    "voice": "en-US-AriaNeural"
  },
  "theme": {
    "stage": "#0b0f17"
  }
}
